project_id = "YOUR_GCP_PROJECT_ID"
region     = "europe-west1"
name       = "core"

owner         = "YOUR_NAME_OR_TEAM"
project_label = "gcp-supply-chain-security"
cost_center   = "YOUR_COST_CENTER"

cluster_name    = "prod-cluster"
cluster_version = "latest"
release_channel = "REGULAR"

# europe-west1 zones in use are b/c/d (no "a" zone here, unlike most regions).
node_locations = ["europe-west1-b", "europe-west1-c"]

private_subnets = {
  main = {
    cidr_block          = "10.0.0.0/20"
    pods_cidr_block     = "10.4.0.0/14"
    services_cidr_block = "10.8.0.0/20"
  }
}

node_pools = {
  main = {
    machine_type = "e2-standard-4"
    min_size     = 1
    max_size     = 5
    desired_size = 2
  }
}

dns_domain_filter = ""

# These features are opt-in because they add permissions and runtime cost.
enable_external_dns       = false
enable_managed_prometheus = false
enable_runtime_alerting   = false

# Runtime alerting is opt-in. Set this non-secret flag here if wanted, but never
# put the webhook URL in a tfvars file. Export it before Terraform instead:
#   export TF_VAR_discord_webhook_url="https://discord.com/api/webhooks/REPLACE_ME"
# Increment TF_VAR_discord_webhook_secret_version whenever the URL rotates.
# enable_runtime_alerting = true
# export TF_VAR_discord_webhook_secret_version=1
